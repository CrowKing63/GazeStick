<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <Description>Webcam eye tracking to virtual gamepad right stick converter</Description>
    <Company>GazeStick</Company>
    <Product>GazeStick</Product>
    <Copyright>Copyright (c) 2026 GazeStick</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="beam-sdk\**\*.cs" />
    <None Remove="beam-sdk\**\*" />
  </ItemGroup>

  <Target Name="CopyBeamDll" AfterTargets="AfterBuild">
    <Copy SourceFiles="beam-sdk\bin\win64\beam_eye_tracker_client.dll" DestinationFolder="$(OutDir)" Condition="Exists('beam-sdk\bin\win64\beam_eye_tracker_client.dll')" />
  </Target>

</Project>